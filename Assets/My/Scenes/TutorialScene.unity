--- !u!114 &1081749765
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1081749763}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ecd34f9bb44ac444185b41860955c680, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialText: {fileID: 965340607}
  messages:
  - "Trace Saber \u3078\u3088\u3046\u3053\u305D\uFF01\uFF01"
  - "\u3053\u3053\u3067\u306F\u3001\u7C21\u5358\u306A\u64CD\u4F5C\u65B9\u6CD5\u3092
    \u899A\u3048\u307E\u3057\u3087\u3046"
  - "\u5DE6\u30B9\u30C6\u30A3\u30C3\u30AF \u3067\u79FB\u52D5\u3067\u304D\u307E\u3059"
  - "A\u30DC\u30BF\u30F3 \u3067\u30B8\u30E3\u30F3\u30D7\u3067\u304D\u307E\u3059"
  - "\u6B21\u306F\u3010\u6226\u95D8\u3011\u306B\u3064\u3044\u3066"
  - "\u5DE6\u624B\u3067 \u5263\u306E\u9798(\u3055\u3084)\u304B\u3089 \u5263\u5148\u307E\u3067\u7D20\u65E9\u304F\u306A\u305E\u308B\u3068\n\u30A8\u30F3\u30C1\u30E3\u30F3\u30C8\u3092\u4ED8\u4E0E\u3067\u304D\u307E\u3059"
  - "\u30A8\u30F3\u30C1\u30E3\u30F3\u30C8\u3057\u305F\u72B6\u614B\u3067 \u5263\u3092\u632F\u308B\u3068
    \u30B9\u30AD\u30EB\u3092\u767A\u52D5\u3067\u304D\u307E\u3059\n\u30A8\u30F3\u30C1\u30E3\u30F3\u30C8\u306F
    3\u6BB5\u968E\u307E\u3067\u3042\u308A \u305D\u308C\u305E\u308C\u7570\u306A\u308B\u30B9\u30AD\u30EB\u3092\u4F7F\u3046\u3053\u3068\u304C\u3067\u304D\u307E\u3059"
  - "\u307E\u305F\u3001\u5DE6\u624B\u306E\u7532\u3092\u307F\u308B\u3068\u5186\u304C\u3042\u308B\u3068\u601D\u3044\u307E\u3059"
  - "\u30B2\u30FC\u30B8\u304C\u6E80\u30BF\u30F3\u306E\u72B6\u614B\u3067 \u30A8\u30F3\u30C1\u30E3\u30F3\u30C83\u3067
    \u5263\u3092\u632F\u308B\u3068\n\u5FC5\u6BBA\u6280\u3092\u767A\u52D5\u3067\u304D\u307E\u3059"
  - "\u30B2\u30FC\u30B8\u306F\n\u6642\u9593\u7D4C\u904E, \u6575\u3092\u5012\u3059,
    \u5CA9\u3092\u8DF3\u306D\u8FD4\u3059 \u7B49\u3067\u8CAF\u3081\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059"
  - "\u5FC5\u6BBA\u6280 \u306F\u5B9F\u969B\u306E\u30B2\u30FC\u30E0\u30D7\u30EC\u30A4\u3067\u8A66\u3057\u3066\u307F\u3066\u306D!"
  - "\u3010\u6575\u3011 \u306B\u3064\u3044\u3066"
  - "\u30DC\u30B9\u304C \u5CA9\u3092\u6295\u3052\u3066\u304F\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\n\u305D\u306E\u5CA9\u3092
    \u30A8\u30F3\u30C1\u30E3\u30F3\u30C8\u3057\u305F\u5263\u3067 \u8DF3\u306D\u8FD4\u3059\u3053\u3068\u304C\u3067\u304D\u307E\u3059"
  - "\u4EE5\u4E0A\u3067 \u30C1\u30E5\u30FC\u30C8\u30EA\u30A2\u30EB \u7D42\u4E86\u3067\u3059\nX
    \u30DC\u30BF\u30F3\u3067 \u30BF\u30A4\u30C8\u30EB\u306B \u623B\u308A\u307E\u3059"
